#version 330 core
uniform float v;uniform vec2 y;out vec4 f;const float m=3.1415927;const int l=96;const float x=60.,i=.001;float n(vec2 v){return fract(sin(dot(v,vec2(127.1,311.7)))*43758.547);}float e(vec2 v){vec2 m=floor(v),f=fract(v);f=f*f*(3.-2.*f);float i=n(m),x=n(m+vec2(1.,0.)),w=n(m+vec2(0.,1.)),c=n(m+vec2(1.,1.));return mix(mix(i,x,f.x),mix(w,c,f.x),f.y);}float t(vec2 v){float f=0.,c=.5;for(int r=0;r<5;r++){f+=c*e(v);v=v*2.03+vec2(1.7,9.2);c*=.5;}return f;}mat2 p(float v){float f=sin(v),x=cos(v);return mat2(x,-f,f,x);}float r(vec3 v,float y){return length(v)-y;}float s(vec3 v,vec3 y){vec3 f=abs(v)-y;return length(max(f,0.))+min(max(f.x,max(f.y,f.z)),0.);}float h(vec3 v,vec2 f){vec2 m=vec2(length(v.xz)-f.x,v.y);return length(m)-f.y;}float c(float v,float m,float f){float y=clamp(.5+.5*(m-v)/f,0.,1.);return mix(m,v,y)-f*y*(1.-y);}vec2 w(vec3 f){float y=f.y+1.+.3*t(f.xz*.5+v*.1);vec3 m=f;m.xz*=p(v*.3);float x=r(m-vec3(0.,.5+.3*sin(v),0.),1.),w=s(m-vec3(2.5,0.,0.),vec3(.7)),i=h(m-vec3(-2.5,0.,0.),vec2(1.,.3)),n=c(x,w,.5);n=min(n,i);float l=n<y?1.:0.;return vec2(min(n,y),l);}vec3 a(vec3 v){vec2 f=vec2(i,0.);return normalize(vec3(w(v+f.xyy).x-w(v-f.xyy).x,w(v+f.yxy).x-w(v-f.yxy).x,w(v+f.yyx).x-w(v-f.yyx).x));}float o(vec3 v,vec3 f,float m,float y,float x){float l=1.,r=m;for(int m=0;m<32;m++){float n=w(v+f*r).x;if(n<i)return 0.;l=min(l,x*n/r);r+=clamp(n,.02,.5);if(r>y)break;}return l;}float u(vec3 v,vec3 y){float f=0.,x=1.;for(int m=0;m<5;m++){float l=.01+.12*float(m)/4.,i=w(v+l*y).x;f+=(l-i)*x;x*=.95;}return clamp(1.-3.*f,0.,1.);}vec2 z(vec3 v,vec3 f){float m=0.,y=-1.;for(int r=0;r<l;r++){vec3 n=v+f*m;vec2 c=w(n);if(c.x<i){y=c.y;break;}m+=c.x;if(m>x){y=-1.;break;}}return vec2(m,y);}vec3 g(vec3 v,vec3 f,vec3 y,float m){vec3 x=normalize(vec3(.6,.7,-.5)),c=m>.5?vec3(.9,.4,.2):vec3(.2,.3,.25)+.1*t(v.xz*2.);float l=max(dot(f,x),0.),i=o(v+f*.02,x,.02,10.,8.),r=u(v,f);vec3 n=normalize(x-y);float z=pow(max(dot(f,n),0.),32.);vec3 w=c*(.2*r+l*i)+z*i*.5;return w;}void main(){vec2 v=(gl_FragCoord.xy-.5*y)/y.y;vec3 m=vec3(0.,1.5,-6.),x=vec3(0.,0.,0.),i=normalize(x-m),r=normalize(cross(vec3(0.,1.,0.),i)),c=cross(i,r),w=normalize(v.x*r+v.y*c+1.8*i);vec2 n=z(m,w);vec3 l;if(n.y<0.)l=mix(vec3(.5,.7,.9),vec3(.1,.2,.4),clamp(w.y*2.+.5,0.,1.));else{vec3 v=m+w*n.x,f=a(v);l=g(v,f,w,n.y);float y=1.-exp(-.02*n.x*n.x);l=mix(l,vec3(.5,.7,.9),y);}l=pow(l,vec3(1./2.2));f=vec4(l,1.);}