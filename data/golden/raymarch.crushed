#version 330 core
uniform float v;uniform vec2 x;out vec4 f;const float m=3.1415927;const int l=96;const float y=60.;const float i=.001;float n(vec2 v){return fract(sin(dot(v,vec2(127.1,311.7)))*43758.547);}float e(vec2 v){vec2 m=floor(v);vec2 f=fract(v);f=f*f*(3.-2.*f);float i=n(m);float x=n(m+vec2(1.,0.));float l=n(m+vec2(0.,1.));float c=n(m+vec2(1.,1.));return mix(mix(i,x,f.x),mix(l,c,f.x),f.y);}float t(vec2 v){float f=0.;float c=.5;for(int r=0;r<5;r++){f+=c*e(v);v=v*2.03+vec2(1.7,9.2);c*=.5;}return f;}mat2 p(float v){float f=sin(v),m=cos(v);return mat2(m,-f,f,m);}float r(vec3 v,float x){return length(v)-x;}float s(vec3 v,vec3 x){vec3 m=abs(v)-x;return length(max(m,0.))+min(max(m.x,max(m.y,m.z)),0.);}float h(vec3 v,vec2 x){vec2 m=vec2(length(v.xz)-x.x,v.y);return length(m)-x.y;}float c(float v,float m,float x){float f=clamp(.5+.5*(m-v)/x,0.,1.);return mix(m,v,f)-x*f*(1.-f);}vec2 w(vec3 m){float f=m.y+1.+.3*t(m.xz*.5+v*.1);vec3 i=m;i.xz*=p(v*.3);float x=r(i-vec3(0.,.5+.3*sin(v),0.),1.);float l=s(i-vec3(2.5,0.,0.),vec3(.7));float y=h(i-vec3(-2.5,0.,0.),vec2(1.,.3));float n=c(x,l,.5);n=min(n,y);float w=n<f?1.:0.;return vec2(min(n,f),w);}vec3 a(vec3 v){vec2 m=vec2(i,0.);return normalize(vec3(w(v+m.xyy).x-w(v-m.xyy).x,w(v+m.yxy).x-w(v-m.yxy).x,w(v+m.yyx).x-w(v-m.yyx).x));}float o(vec3 v,vec3 m,float x,float f,float y){float l=1.;float r=x;for(int c=0;c<32;c++){float x=w(v+m*r).x;if(x<i)return 0.;l=min(l,y*x/r);r+=clamp(x,.02,.5);if(r>f)break;}return l;}float u(vec3 v,vec3 x){float f=0.;float m=1.;for(int r=0;r<5;r++){float i=.01+.12*float(r)/4.;float y=w(v+i*x).x;f+=(i-y)*m;m*=.95;}return clamp(1.-3.*f,0.,1.);}vec2 z(vec3 v,vec3 x){float m=0.;float f=-1.;for(int r=0;r<l;r++){vec3 c=v+x*m;vec2 n=w(c);if(n.x<i){f=n.y;break;}m+=n.x;if(m>y){f=-1.;break;}}return vec2(m,f);}vec3 g(vec3 v,vec3 m,vec3 x,float f){vec3 i=normalize(vec3(.6,.7,-.5));vec3 n=f>.5?vec3(.9,.4,.2):vec3(.2,.3,.25)+.1*t(v.xz*2.);float l=max(dot(m,i),0.);float y=o(v+m*.02,i,.02,10.,8.);float r=u(v,m);vec3 c=normalize(i-x);float z=pow(max(dot(m,c),0.),32.);vec3 w=n*(.2*r+l*y)+z*y*.5;return w;}void main(){vec2 m=(gl_FragCoord.xy-.5*x)/x.y;vec3 v=vec3(0.,1.5,-6.);vec3 i=vec3(0.,0.,0.);vec3 y=normalize(i-v);vec3 r=normalize(cross(vec3(0.,1.,0.),y));vec3 l=cross(y,r);vec3 c=normalize(m.x*r+m.y*l+1.8*y);vec2 n=z(v,c);vec3 w;if(n.y<0.){w=mix(vec3(.5,.7,.9),vec3(.1,.2,.4),clamp(c.y*2.+.5,0.,1.));}else{vec3 m=v+c*n.x;vec3 f=a(m);w=g(m,f,c,n.y);float x=1.-exp(-.02*n.x*n.x);w=mix(w,vec3(.5,.7,.9),x);}w=pow(w,vec3(1./2.2));f=vec4(w,1.);}