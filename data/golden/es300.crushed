#version 300 es
precision highp float;precision mediump int;layout(location=0)out vec4 f;in vec2 v;flat in int u;uniform sampler2D t;uniform Params{vec4 tint;float threshold;int iterations;}d;struct i{vec3 e;vec3 i;float c;};uniform i m[2];const vec3 e[3]=vec3[3](vec3(.299,.587,.114),vec3(1.,0.,0.),vec3(0.,0.,1.));float x(vec3 v,int i){return dot(v,e[i]);}vec3 n(vec3 v,vec3 i){vec3 f=vec3(0.);for(int u=0;u<2;++u){float t=max(dot(i,normalize(m[u].e)),0.);f+=v*m[u].i*m[u].c*t;}return f;}uint h(uvec2 d){uint f=2166136261u;f=(f^d.x)*16777619u;f=(f^d.y)*16777619u;return f>>3u;}void main(){vec4 i=texture(t,v);vec3 m=i.rgb*d.tint.rgb;float y=x(m,u);vec3 e=normalize(vec3(v-.5,1.));vec3 c=n(m,e);int s=0;do{c*=.98;s++;}while(s<d.iterations);switch(u){case 0:c=vec3(y);break;case 1:c=y>d.threshold?c:vec3(0.);break;default:c=mix(c,vec3(y),.5);}uint l=h(uvec2(gl_FragCoord.xy));float a=float(l&255u)/255.-.5;c+=a*.01;f=vec4(c,i.a*d.tint.a);}