#version 410
void main(){float o=1.;float a=2.;float l=3.;float f=4.;float t=5.;float v=o+a*(l+f*(t-o));float e=(o+a)*(l-f)/(t+o-a*l);float c=max(min(o,a),min(l,f));vec2 i=vec2(o,a);vec2 m=vec2(l,f);float n=(i.x+m.y)*(i.y-m.x);float x=o>a?l>f?t:o:a>l?f:t;bool r=o>a&&l<f||t>=o&&a<=l;vec4 g=vec4(vec3(o,a,l),f);float y=max(o*a+l,min(f/t,(o+a)*(l-f)));gl_FragColor=vec4(v,e,c,1.);}