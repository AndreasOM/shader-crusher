#version 410
void main(){float v=1.,m=2.,y=3.,x=4.,r=5.,o=v+m*(y+x*(r-v)),e=(v+m)*(y-x)/(r+v-m*y),a=max(min(v,m),min(y,x));vec2 c=vec2(v,m),i=vec2(y,x);float l=(c.x+i.y)*(c.y-i.x),n=v>m?y>x?r:v:m>y?x:r;bool f=v>m&&y<x||r>=v&&m<=y;vec4 t=vec4(vec3(v,m,y),x);float g=max(v*m+y,min(x/r,(v+m)*(y-x)));gl_FragColor=vec4(o,e,a,1.);}