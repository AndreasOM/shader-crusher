#version 410
void main(){float v=1.;float m=2.;float y=3.;float x=4.;float r=5.;float o=v+m*(y+x*(r-v));float a=(v+m)*(y-x)/(r+v-m*y);float l=max(min(v,m),min(y,x));vec2 f=vec2(v,m);vec2 t=vec2(y,x);float e=(f.x+t.y)*(f.y-t.x);float c=v>m?y>x?r:v:m>y?x:r;bool i=v>m&&y<x||r>=v&&m<=y;vec4 n=vec4(vec3(v,m,y),x);float g=max(v*m+y,min(x/r,(v+m)*(y-x)));gl_FragColor=vec4(o,a,l,1.);}