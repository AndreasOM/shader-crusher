#version 120
#define SQ(v) ((v)*(v))
#define NEG(q) -(q)
#define HALF (scale_factor*0.5)
uniform float scale_factor;uniform sampler2D i;precision mediump float;struct h{vec3 position;float k;};uniform h f;varying vec2 l;float j(float m){float c=m*2.;return c;}void main(){float c=.5;vec2 e=l.xy*1e2+.001;vec3 p=f.position+gl_LightSource[0].position.xyz;float x=p.x+p.y,a=SQ(e.x+1.)+NEG(c)+HALF+j(.25)- -c;vec4 d=texture2D(i,e)*(x,a);d.rgb=d.bgr*f.k;gl_FragColor=(d,vec4(x,a,e,1e-5));gl_Position=ftransform();}